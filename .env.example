# Copy this file to ".env" and fill in your own values.
# start.bat does this for you automatically on first run.

# 3004 - ports 3000-3003 are used by the other AEC apps.
PORT=3004

# A long random string used to sign login tokens. Never share it.
JWT_SECRET=change-this-to-a-long-random-string

# Local use: a database file on this PC (no account needed).
DB_URL=file:./data/workshop.db
DB_AUTH_TOKEN=

# Online (e.g. Render): point these at a Turso database instead -
# DB_URL=libsql://your-db-name-your-org.turso.io
# DB_AUTH_TOKEN=<the token Turso gives you for this database>
